---
// A real Moonbow screenshot from src/assets/shots/<name>.png, served as sized AVIF/WebP.
// `frame` = a Windows 11 window (rounded, hairline edge). `develop` = appears from black in 200 ms.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { shots } from '../data/site';

interface Props {
  name: string;
  alt?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  frame?: boolean;
  develop?: boolean;
  intro?: boolean;
  class?: string;
}
const { name, alt, sizes = '(max-width: 800px) 100vw, 60vw', widths = [480, 720, 960, 1280, 1600, 2048], eager = false, frame = true, develop = true, intro = false, class: cls } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.{png,jpg,webp}', { eager: true });
const entry = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === name);
if (!entry) throw new Error(`No screenshot "${name}" in src/assets/shots`);
const src = entry[1].default;
const text = alt ?? shots[name]?.alt ?? '';
// Phones get the part of the window that matters (tools/shots/crops.mjs), so UI text stays readable.
const crops = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/crops/*.{png,jpg}', { eager: true });
const crop = eager ? undefined : Object.entries(crops).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1].default;
---
<div class:list={[frame && 'window', cls]} data-reveal={develop ? 'develop' : undefined} data-intro={intro ? '' : undefined}>
  <Picture
    src={src}
    alt={text}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths.filter((w) => w <= src.width)}
    width={Math.min(1280, src.width)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    quality={78}
    class={crop ? 'shot__full' : undefined}
  />
  {crop && (
    <Picture src={crop} alt={text} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 1080].filter((w) => w <= crop.width)}
      width={Math.min(720, crop.width)} sizes="100vw" loading="lazy" decoding="async" quality={80} class="shot__crop" />
  )}
</div>

<style>
  /* Global: the classes land on the <img> that Astro's Picture renders, outside this scope. */
  :global(.shot__crop) { display: none; }
  @media (max-width: 600px) {
    :global(.shot__full) { display: none; }
    :global(.shot__crop) { display: block; }
  }
</style>
