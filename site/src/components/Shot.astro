---
// A real Lumen screenshot in a window frame. `name` is a file in src/assets/shots without .webp.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; alt: string; caption?: string; eager?: boolean; dark?: boolean; sizes?: string; class?: string }
const { name, alt, caption, eager = false, dark = false, sizes = '(max-width: 767px) 100vw, 60vw', class: cls } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.webp', { eager: true });
const src = shots[`../assets/shots/${name}.webp`]?.default ?? shots['../assets/shots/player-film.webp']?.default;
---
<figure class:list={['shot', cls]}>
  <div class="shot__frame">
    {src && (
      <Image src={src} alt={alt} widths={[480, 800, 1200, 1440]} sizes={sizes}
        loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} format="webp" quality={82} />
    )}
    <div class="shot__dark" style={dark ? 'opacity:1' : undefined} aria-hidden="true"></div>
  </div>
  {caption && <figcaption class="label">{caption}</figcaption>}
</figure>
