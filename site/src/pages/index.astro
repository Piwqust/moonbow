---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Gate from '../components/Gate.astro';
import PlayIcon from '../components/PlayIcon.astro';
import FrameCounter from '../components/FrameCounter.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { areas, facts, download, shots } from '../data/site';
import settings from '../data/app/settings.json';
import actions from '../data/app/actions.json';
import formats from '../data/app/formats.json';

const nFormats = Object.values(formats).reduce((a, v) => a + v.length, 0);
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.{png,jpg}', { eager: true });
const shotSrc = (name: string) => Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1].default;
const cropFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/crops/*.{png,jpg}', { eager: true });
const cropSrc = (name: string) => Object.entries(cropFiles).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1].default ?? shotSrc(name);
---
<Base>
  <!-- POSTER -->
  <section class="hero wrap" aria-labelledby="hero-h">
    <div class="hero__text">
      <h1 id="hero-h" class="hero__h t-xl">
        <span class="sr-only">Moonbow, плеер для Windows. </span>
        <span class="hero__line">Двойной щелчок.</span>
        <span class="hero__line">Восемь кадров.</span>
        <span class="hero__line">Фильм идёт.</span>
      </h1>
      <p class="hero__lead t-m soft">Видео- и музыкальный плеер для Windows&nbsp;10 и&nbsp;11. Красивый, мгновенный и умеет всё: медиатека, сериалы, субтитры, тексты песен и {settings.valueCount}&nbsp;настроек на случай, если захочется больше.</p>
      <div class="hero__actions">
        <a class="play" href="/download/"><PlayIcon /><span class="roll"><span>Скачать для Windows</span><span aria-hidden="true">Скачать для Windows</span></span></a>
        <a class="ghost" href="/features/"><span class="roll"><span>Что он умеет</span><span aria-hidden="true">Что он умеет</span></span></a>
      </div>
      <p class="hero__meta edge">Бесплатно. {download.setup.size}. {download.requirements}.</p>
    </div>
    <figure class="hero__shot">
      <div class="strip">
        <span class="strip__edge edge" aria-hidden="true"><span class="strip__brand">MOONBOW  </span>S01E04  13:51  24 FPS</span>
        <Shot name="hero" eager intro sizes="(max-width: 800px) 100vw, 60vw" />
      </div>
      <figcaption class="hero__cap">
        <span class="soft">Серия «Дом у моря» в Moonbow. Цвет на этой странице есть только в кадре.</span>
      </figcaption>
    </figure>
    <FrameCounter class="hero__fc" />
  </section>

  <!-- THE BET -->
  <section class="bet wrap" aria-labelledby="bet-h">
    <h2 id="bet-h" class="bet__label edge">Спор</h2>
    <p class="bet__text t-l" data-split="lines">Спор был простой: на Windows нет плеера, который одновременно красивый, мгновенный и умеет всё. Обычно выбираешь два из трёх: красивый и бедный, всеядный и тяжёлый, быстрый и голый. Moonbow написан, чтобы не выбирать.</p>
    <ol class="bet__terms">
      <li><a href="#instant" class="roll-host frameline"><span class="bet__n edge">1</span><span class="roll"><span>Мгновенный</span><span aria-hidden="true">Мгновенный</span></span><span class="bet__d soft">Фильм идёт на восьмом кадре</span></a></li>
      <li><a href="#beautiful" class="roll-host frameline"><span class="bet__n edge">2</span><span class="roll"><span>Красивый</span><span aria-hidden="true">Красивый</span></span><span class="bet__d soft">Весь цвет в кадре</span></a></li>
      <li><a href="#everything" class="roll-host frameline"><span class="bet__n edge">3</span><span class="roll"><span>Умеет всё</span><span aria-hidden="true">Умеет всё</span></span><span class="bet__d soft">{settings.valueCount} настроек, {actions.count} команд</span></a></li>
    </ol>
  </section>

  <!-- 1. INSTANT -->
  <section class="chapter" id="instant" aria-labelledby="instant-h">
    <header class="chapter__head wrap">
      <p class="chapter__no edge">1  Мгновенный</p>
      <h2 id="instant-h" class="t-mega chapter__title" data-split="lines">Восемь кадров</h2>
      <p class="chapter__lead t-m soft" data-reveal="down">В кино за секунду проходит 24 кадра. От двойного щелчка по файлу до идущего фильма Moonbow тратит восемь. Прокрутите, и плёнка пройдёт через окно по одному кадру, какими они были на самом деле.</p>
    </header>
    <Gate />
    <div class="facts wrap">
      <h3 class="sr-only">Другие замеры</h3>
      <ul class="facts__list">
        {facts.map((f) => (
          <li class="facts__item" data-reveal="down">
            <p class="facts__value">{f.value}</p>
            <p class="facts__label">{f.label}</p>
            <p class="facts__note muted">{f.note}</p>
          </li>
        ))}
      </ul>
      <p class="facts__more"><a class="link" href="/speed/">Как это измерено и что сделано ради скорости</a></p>
    </div>
  </section>

  <!-- 2. BEAUTIFUL -->
  <section class="chapter beauty" id="beautiful" aria-labelledby="beautiful-h">
    <header class="chapter__head wrap">
      <p class="chapter__no edge">2  Красивый</p>
      <h2 id="beautiful-h" class="t-mega chapter__title" data-split="lines">Весь цвет в кадре</h2>
    </header>
    <div class="beauty__story wrap">
      <p class="t-m" data-reveal="down">Лунная радуга бывает ночью у водопадов, при полной луне. Глазу она кажется белой: в темноте мы почти не различаем цвета.</p>
      <p class="soft" data-reveal="down">Цвет в ней есть, его видно только на длинной выдержке. Отсюда имя и главное правило интерфейса: всё белое, серое и чёрное, а цветными остаются только ваши фильмы и обложки. Никаких цветных кнопок, полос и значков, которые спорят с кадром.</p>
    </div>
    <div class="wall wrap">
      <figure class="wall__a"><Shot name="library-home" sizes="(max-width: 800px) 100vw, 64vw" /><figcaption class="soft">Главная медиатеки: продолжить с того места, где остановились.</figcaption></figure>
      <figure class="wall__b"><Shot name="music-lyrics" sizes="(max-width: 800px) 100vw, 40vw" /><figcaption class="soft">Песня с обложкой и синхронным текстом.</figcaption></figure>
      <figure class="wall__c"><Shot name="series" sizes="(max-width: 800px) 100vw, 40vw" /><figcaption class="soft">Сериал сам раскладывается по сезонам.</figcaption></figure>
      <figure class="wall__d"><Shot name="subtitles" sizes="(max-width: 800px) 100vw, 56vw" /><figcaption class="soft">Стиль субтитров выбирается на живом кадре.</figcaption></figure>
    </div>
    <p class="beauty__note wrap soft">Есть светлая тема, системная, скины «Чёрный OLED», «Высокий контраст» и «Сепия», пять оттенков белого для акцента и свой JSON-скин, который перечитывается на лету.</p>
  </section>

  <!-- 3. EVERYTHING -->
  <section class="chapter all" id="everything" aria-labelledby="everything-h">
    <header class="chapter__head wrap">
      <p class="chapter__no edge">3  Умеет всё</p>
      <h2 id="everything-h" class="t-mega chapter__title" data-split="lines">Умеет всё</h2>
      <p class="chapter__lead t-m soft" data-reveal="down">{settings.valueCount} настроек, {actions.count} команд, {nFormats} форматов файлов. На виду только то, что нужно сейчас. Остальное ждёт в коротких панелях у кнопок, в палитре Ctrl+K и в поиске по настройкам.</p>
    </header>
    <div class="wrap">
      <ol class="index" data-index>
        {areas.map((a, i) => {
          const src = cropSrc(a.shot);
          return (
            <li>
              <a href={`/features/#${a.id}`} data-row={i} class="index__row roll-host frameline">
                <span class="index__n edge">{String(i + 1).padStart(2, '0')}</span>
                <span class="index__title"><span class="roll"><span>{a.title}</span><span aria-hidden="true">{a.title}</span></span></span>
                <span class="index__sum soft">{a.summary}</span>
                {src && <span class="index__thumb" aria-hidden="true"><Picture src={src} alt={shots[a.shot]?.alt ?? a.title} formats={['avif', 'webp']} fallbackFormat="jpg" width={720} widths={[480, 720]} sizes="40vw" loading="lazy" decoding="async" quality={70} /></span>}
              </a>
            </li>
          );
        })}
      </ol>
      <div class="preview" data-index-preview aria-hidden="true">
        <div class="preview__strip">
          {areas.map((a, i) => {
            const src = shotSrc(a.shot);
            return src && <div class="preview__frame" style={`--i:${i}`}><Picture src={src} alt={shots[a.shot]?.alt ?? a.title} formats={['avif', 'webp']} fallbackFormat="jpg" width={720} widths={[480, 720]} sizes="26vw" loading="lazy" decoding="async" quality={70} /></div>;
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- FINALE -->
  <section class="finale wrap" aria-labelledby="finale-h">
    <h2 id="finale-h" class="t-mega finale__h" data-split="lines">Откройте свой фильм</h2>
    <div class="finale__row">
      <a class="play finale__play" href="/download/"><PlayIcon /><span class="roll"><span>Скачать для Windows</span><span aria-hidden="true">Скачать для Windows</span></span></a>
      <dl class="finale__specs">
        <div><dt class="edge">Установщик</dt><dd>{download.setup.size}</dd></div>
        <div><dt class="edge">Архив zip</dt><dd>{download.zip.size}</dd></div>
        <div><dt class="edge">Система</dt><dd>{download.requirements}</dd></div>
        <div><dt class="edge">Цена</dt><dd>Бесплатно, GPL-3.0</dd></div>
      </dl>
    </div>
    <p class="finale__note muted">Ставится в вашу папку пользователя, без прав администратора. Подписи кода пока нет, поэтому Windows SmartScreen спросит, доверяете ли вы файлу. <a class="link" href="/download/">Подробнее об установке</a></p>
  </section>
</Base>

<style>
  /* ---------- Poster */
  .hero {
    position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    min-height: calc(100svh - var(--header-h)); align-content: center; row-gap: 2rem;
    padding-block: clamp(1.5rem, 4vh, 3rem) clamp(4.5rem, 9vh, 6rem);
  }
  .hero__text { grid-column: 1 / span 5; grid-row: 1; align-self: center; position: relative; z-index: 1; }
  .hero__h { font-weight: 400; font-size: clamp(2.3rem, 0.9rem + 3.9vw, 5.1rem); line-height: 0.98; letter-spacing: -0.045em; }
  .hero__line { display: block; white-space: nowrap; }
  .hero__lead { margin-top: clamp(1.25rem, 2.5vw, 2rem); max-width: 30rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.5rem, 3vw, 2.25rem); }
  .hero__meta { margin-top: 1rem; }
  .hero__shot { grid-column: 6 / span 7; grid-row: 1; align-self: center; }
  .hero__cap { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 0.9rem; font-size: var(--t-s); padding-left: var(--lane); }
  .hero :global(.hero__fc) { position: absolute; right: var(--gutter); bottom: 1.25rem; }

  /* ---------- The bet */
  .bet { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-block: clamp(5rem, 14vw, 12rem) clamp(4rem, 9vw, 8rem); }
  .bet__label { grid-column: 1 / span 2; padding-top: 0.7em; }
  .bet__text { grid-column: 3 / span 9; text-indent: 0; }
  .bet__terms { grid-column: 3 / span 10; margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--c-line); }
  .bet__terms a { display: grid; gap: 0.4rem; padding: 1.25rem 1.25rem 1.25rem 0; min-height: 7.5rem; align-content: start; border-right: 1px solid var(--c-line); margin-right: 1.25rem; }
  .bet__terms li:last-child a { border-right: 0; }
  .bet__terms .roll { font-size: var(--t-m); letter-spacing: -0.015em; }
  .bet__n { color: var(--c-fg); }
  .bet__d { font-size: var(--t-s); transition: color 0.18s; }
  @media (hover: hover) { .bet__terms a:hover .bet__d { color: var(--c-fg); } }

  /* ---------- Chapters */
  .chapter { padding-top: clamp(4rem, 10vw, 9rem); }
  .chapter__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .chapter__no { grid-column: 1 / -1; color: var(--c-fg); white-space: pre; }
  .chapter__title { grid-column: 1 / -1; margin-top: 0.5rem; margin-left: -0.05em; }
  .chapter__lead { grid-column: 5 / span 7; margin-top: clamp(1.25rem, 2.5vw, 2rem); }

  .facts { margin-top: clamp(4rem, 8vw, 7rem); }
  .facts__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gutter); border-top: 1px solid var(--c-line); }
  .facts__item { padding-top: 1.25rem; }
  .facts__value { font-size: var(--t-xl); letter-spacing: -0.05em; line-height: 1; font-weight: 300; }
  .facts__label { margin-top: 0.75rem; font-weight: 500; }
  .facts__note { margin-top: 0.4rem; font-size: var(--t-s); max-width: 18rem; }
  .facts__more { margin-top: 1.5rem; }
  .facts__more .link { display: inline-block; padding-block: 0.7rem; }

  /* ---------- Beautiful: the wall */
  .beauty__story { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .beauty__story p:first-child { grid-column: 5 / span 6; }
  .beauty__story p:last-child { grid-column: 5 / span 5; margin-top: 1.25rem; }
  .wall { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: clamp(2rem, 5vw, 4.5rem); margin-top: clamp(3rem, 7vw, 6rem); }
  .wall figcaption { margin-top: 0.8rem; font-size: var(--t-s); }
  .wall__a { grid-column: 1 / span 8; }
  .wall__b { grid-column: 9 / span 4; align-self: end; }
  .wall__c { grid-column: 2 / span 5; }
  .wall__d { grid-column: 7 / span 6; margin-top: clamp(3rem, 9vw, 9rem); }
  .beauty__note { margin-top: clamp(2.5rem, 5vw, 4rem); max-width: calc(var(--max)); font-size: var(--t-s); }
  .beauty__note { padding-left: calc(var(--gutter) + (100% - 2 * var(--gutter)) / 12 * 4); }

  /* ---------- Everything: the index */
  .index { margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--c-line); }
  .index li { border-bottom: 1px solid var(--c-line); }
  .index__row { display: grid; grid-template-columns: 4rem minmax(0, 4fr) minmax(0, 6fr); align-items: baseline; column-gap: var(--gutter); padding-block: clamp(1rem, 2vw, 1.6rem); transition: background-color 0.18s; }
  .index__title { font-size: var(--t-l); letter-spacing: -0.03em; line-height: 1.1; }
  .index__sum { font-size: var(--t-body); max-width: 36rem; transition: color 0.18s; }
  @media (hover: hover) { .index__row:hover .index__sum { color: var(--c-fg); } }
  .index__thumb { display: none; }
  @media (hover: hover) { .index__row:hover { background: rgb(255 255 255 / 0.025); } }
  .index__row:active { background: rgb(255 255 255 / 0.05); }

  .preview {
    position: fixed; left: 0; top: 0; z-index: 5; pointer-events: none; width: clamp(16rem, 24vw, 24rem);
    translate: 1.5rem -50%; visibility: hidden; opacity: 0;
    aspect-ratio: 16 / 10; overflow: clip; border-radius: 6px; background: #000;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 30px 80px -20px rgb(0 0 0 / 0.9);
  }
  .preview__strip { position: absolute; inset: 0; }
  .preview__frame { position: absolute; inset: 0; transform: translate3d(0, calc((var(--pos, 0) - var(--i)) * 108%), 0); }
  .preview__frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; }

  /* ---------- Finale */
  .finale { padding-top: clamp(6rem, 16vw, 14rem); }
  .finale__h { margin-left: -0.05em; max-width: 12ch; }
  .finale__row { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem clamp(2rem, 5vw, 5rem); margin-top: clamp(2rem, 4vw, 3rem); }
  .finale__play { --h: 4rem; font-size: 1.2rem; padding-inline: 1.5em 1.9em; }
  .finale__specs { display: grid; grid-template-columns: repeat(4, auto); gap: 0.5rem 2.5rem; }
  .finale__specs dd { margin-top: 0.25rem; }
  .finale__note { margin-top: 2rem; max-width: 40rem; font-size: var(--t-s); }

  /* ---------- Tablet */
  @media (max-width: 1100px) {
    .hero__text { grid-column: 1 / span 6; }
    .hero__shot { grid-column: 7 / span 6; }
    .finale__specs { grid-template-columns: repeat(2, auto); }
  }
  /* ---------- Phone: re-composed, not shrunk */
  @media (max-width: 800px) {
    .hero { min-height: 0; align-content: start; row-gap: 2.25rem; padding-top: 1.5rem; padding-bottom: 5rem; }
    .hero__text, .hero__shot { grid-column: 1 / -1; grid-row: auto; }
    .hero__h { font-size: clamp(2.3rem, 11.4vw, 3.4rem); }
    .hero__shot { margin-inline: calc(var(--gutter) * -1); }
    .hero__shot .strip { border-radius: 0; }
    .strip :global(.window) { border-radius: 3px; }
    .hero__cap { padding-inline: var(--gutter); }
    .hero :global(.hero__fc) { position: static; grid-column: 1 / -1; justify-self: start; margin-top: -0.75rem; }
    .bet__label, .bet__text, .bet__terms { grid-column: 1 / -1; }
    .bet__label { padding: 0 0 1rem; }
    .bet__terms { grid-template-columns: 1fr; }
    .bet__terms a { border-right: 0; margin-right: 0; min-height: 0; border-bottom: 1px solid var(--c-line); grid-template-columns: 1.5rem auto; column-gap: 0.75rem; }
    .bet__terms li:last-child a { border-bottom: 0; }
    .bet__d { grid-column: 2; }
    .chapter__lead { grid-column: 1 / -1; }
    .chapter__title { font-size: clamp(2.6rem, 13.5vw, 4rem); }
    .facts__list { grid-template-columns: 1fr 1fr; row-gap: 2rem; }
    .beauty__story p:first-child, .beauty__story p:last-child { grid-column: 1 / -1; }
    .wall__a, .wall__b, .wall__c, .wall__d { grid-column: 1 / -1; margin-top: 0; }
    .beauty__note { padding-left: var(--gutter); }
    .index__row { grid-template-columns: 2.25rem minmax(0, 1fr); row-gap: 0.5rem; }
    .index__sum { grid-column: 2; font-size: var(--t-s); }
    .index__thumb { display: block; grid-column: 2; margin-top: 0.5rem; border-radius: 6px; overflow: clip; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.07); }
    .finale__specs { grid-template-columns: 1fr 1fr; }
    .finale__h { font-size: clamp(2.6rem, 13.5vw, 4rem); }
  }
  /* Touch or reduced motion: thumbnails inline, no floating gate. */
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .preview { display: none; }
  }
  @media (prefers-reduced-motion: reduce) and (min-width: 801px) {
    .index__row { grid-template-columns: 4rem minmax(0, 3fr) minmax(0, 5fr) minmax(0, 2fr); }
    .index__thumb { display: block; border-radius: 4px; overflow: clip; align-self: center; }
  }
</style>
