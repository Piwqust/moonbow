---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { areas } from '../data/site';
import settings from '../data/app/settings.json';
import formats from '../data/app/formats.json';

// Screens per area on this page (the home uses others for some areas).
const shotFor: Record<string, string> = {
  player: 'player-seek', video: 'player-stats', audio: 'meters', subtitles: 'settings',
  music: 'music-lyrics', library: 'series', look: 'home-light', system: 'palette',
};
const capFor: Record<string, string> = {
  player: 'Наведите на полосу перемотки: над ней превью кадра и название главы.',
  video: 'Статистика поверх видео: декодер работает без копирования кадров.',
  audio: 'Окно индикаторов: стрелочные VU, громкость EBU R128, стереобаза и спектр.',
  subtitles: 'Стиль субтитров выбирается на образце поверх настоящего кадра.',
  music: 'Текст песни идёт вместе с ней, текущая строка ярче остальных.',
  library: 'Сериал раскладывается по сезонам, у начатых серий видно, сколько осталось.',
  look: 'Светлая тема: та же раскладка, только наоборот.',
  system: 'Ctrl+K: любая команда плеера по названию.',
};
const kindRu: Record<string, string> = {
  toggle: 'переключатель', choice: 'выбор', segmented: 'выбор', slider: 'ползунок', number: 'число',
  text: 'текст', path: 'путь', color: 'цвет', accentPicker: 'оттенок',
};
const valueKinds = new Set(Object.keys(kindRu));
// The site writes without dashes; the player's descriptions use " — " where a colon reads the same.
const nd = (t: string) => t.replace(/\s+[—–]\s+/g, ': ');
const pages = settings.pages
  .map((p) => ({ ...p, sections: p.sections.map((s) => ({ ...s, settings: s.settings.filter((x) => valueKinds.has(x.kind)) })).filter((s) => s.settings.length) }))
  .filter((p) => p.sections.length);
const count = (p: (typeof pages)[number]) => p.sections.reduce((a, s) => a + s.settings.length, 0);
const plural = (n: number, one: string, few: string, many: string) => {
  const a = n % 10, b = n % 100;
  return a === 1 && b !== 11 ? one : a >= 2 && a <= 4 && (b < 12 || b > 14) ? few : many;
};
const fmtNames: Record<string, string> = { video: 'Видео', audio: 'Звук', subtitles: 'Субтитры', playlists: 'Плейлисты' };
---
<Base title="Возможности" description={`Всё, что умеет Moonbow: плеер, видео, звук, субтитры, музыка, медиатека, оформление и система. И все ${settings.valueCount} настроек с поиском, прямо из кода плеера.`}>
  <header class="phead wrap">
    <p class="edge phead__no">Возможности</p>
    <h1 class="t-xl phead__h">Всё, что он умеет</h1>
    <p class="phead__lead t-m soft">Восемь разделов, {settings.valueCount} настроек и {Object.values(formats).reduce((a, v) => a + v.length, 0)} форматов файлов. Списки ниже собраны прямо из исходного кода плеера, поэтому совпадают с тем, что вы увидите в его окне.</p>
    <nav class="toc" aria-label="Разделы возможностей">
      <ol>
        {areas.map((a, i) => <li><a href={`#${a.id}`} class="toc__a frameline"><span class="edge">{String(i + 1).padStart(2, '0')}</span><span class="roll"><span>{a.title}</span><span aria-hidden="true">{a.title}</span></span></a></li>)}
        <li><a href="#formats" class="toc__a frameline"><span class="edge">09</span><span class="roll"><span>Форматы</span><span aria-hidden="true">Форматы</span></span></a></li>
        <li><a href="#settings" class="toc__a frameline"><span class="edge">10</span><span class="roll"><span>Все настройки</span><span aria-hidden="true">Все настройки</span></span></a></li>
      </ol>
    </nav>
  </header>

  {areas.map((a, i) => (
    <section class:list={['area', 'wrap', i % 2 === 1 && 'area--flip']} id={a.id} aria-labelledby={`${a.id}-h`}>
      <div class="area__text">
        <p class="edge area__no">{String(i + 1).padStart(2, '0')}</p>
        <h2 id={`${a.id}-h`} class="t-l area__h">{a.title}</h2>
        <p class="area__sum soft">{a.summary}</p>
        <ul class="area__list">
          {a.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </div>
      <figure class="area__shot">
        <div class="strip">
          <span class="strip__edge edge" aria-hidden="true"><span class="strip__brand">MOONBOW  </span>{String(i + 1).padStart(2, '0')}  {a.title.toUpperCase()}</span>
          <Shot name={shotFor[a.id]} sizes="(max-width: 900px) 100vw, 56vw" />
        </div>
        <figcaption class="soft">{capFor[a.id]}</figcaption>
      </figure>
    </section>
  ))}

  <section class="formats wrap" id="formats" aria-labelledby="formats-h">
    <p class="edge area__no">09</p>
    <h2 id="formats-h" class="t-l">Форматы</h2>
    <p class="soft formats__lead">Всё, что умеет libmpv, Moonbow откроет. Эти расширения он узнаёт в медиатеке, в диалоге открытия и в ассоциациях файлов.</p>
    <dl class="formats__grid">
      {Object.entries(formats).map(([k, list]) => (
        <div class="formats__row">
          <dt>{fmtNames[k] ?? k} <span class="edge">{list.length}</span></dt>
          <dd class="edge">{list.join('  ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="settings wrap" id="settings" aria-labelledby="settings-h">
    <p class="edge area__no">10</p>
    <h2 id="settings-h" class="t-l">Все {settings.valueCount} настроек</h2>
    <p class="soft settings__lead">Так же, как в окне настроек Moonbow: ищите любым словом, порядок слов не важен. Разделы раскрываются по щелчку.</p>
    <div class="search">
      <label for="settings-q" class="sr-only">Поиск по настройкам</label>
      <svg class="search__icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      <input id="settings-q" type="search" aria-label="Поиск по настройкам" placeholder="Например: субтитры размер" autocomplete="off" data-filter="#settings-list" />
      <span class="edge search__count" data-filter-count="settings-q" aria-live="polite">{settings.valueCount}</span>
    </div>
    <p class="search__empty soft" data-filter-empty="settings-q" hidden>Ничего не нашлось. Попробуйте другое слово.</p>
    <div id="settings-list" class="settings__list">
      {pages.map((p) => (
        <details class="sp" data-group>
          <summary class="sp__sum">
            <span class="sp__name">{p.ru}</span>
            <span class="edge sp__n">{count(p)} {plural(count(p), 'настройка', 'настройки', 'настроек')}</span>
            <span class="sp__chev" aria-hidden="true"></span>
          </summary>
          {p.sections.map((s) => (
            <div class="ss" data-group>
              <h3 class="ss__h edge">{s.ru}</h3>
              <ul>
                {s.settings.map((x) => (
                  <li class="row" data-item data-text={`${p.ru} ${s.ru} ${x.ru} ${x.descRu ?? ''} ${(x.options ?? []).map((o) => o.ru).join(' ')}`}>
                    <span class="row__name">{nd(x.ru)}</span>
                    {x.descRu && <span class="row__desc soft">{nd(x.descRu)}</span>}
                    <span class="row__kind edge">{kindRu[x.kind]}{x.options && x.options.length > 1 && !x.dynamic ? `: ${x.options.map((o) => nd(o.ru)).join(', ')}` : ''}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .phead { padding-top: clamp(2.5rem, 7vw, 6rem); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .phead__no, .phead__h, .phead__lead { grid-column: 1 / -1; }
  .phead__no { color: var(--c-fg); }
  .phead__h { margin-top: 0.4rem; margin-left: -0.05em; }
  .phead__lead { grid-column: 5 / span 7; margin-top: clamp(1.25rem, 2.5vw, 2rem); }
  .toc { grid-column: 1 / -1; margin-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--c-line); }
  .toc ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .toc__a { display: flex; align-items: baseline; gap: 0.75rem; min-height: 3.25rem; padding-block: 0.9rem; border-bottom: 1px solid var(--c-line); font-size: 1.0625rem; }
  /* Numbers as frame cells, like the cells under the gate on the home page. */
  .toc__a .edge { display: inline-grid; place-items: end start; min-width: 2.1rem; height: 1.6rem; padding: 0.15rem 0.25rem; border: 1px solid var(--c-line-strong); font-size: 0.625rem; color: var(--c-muted); transition: background-color 0.16s, color 0.16s, border-color 0.16s; }
  @media (hover: hover) { .toc__a:hover .edge { background: var(--c-fg); border-color: var(--c-fg); color: var(--c-bg); } }
  .toc__a:focus-visible .edge { background: var(--c-fg); border-color: var(--c-fg); color: var(--c-bg); }
  .toc__a { align-items: center; }

  .area { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2rem; padding-top: clamp(5rem, 11vw, 9rem); align-items: start; }
  .area__text { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .area__shot { grid-column: 6 / span 7; }
  .area--flip .area__text { grid-column: 9 / span 4; grid-row: 1; }
  .area--flip .area__shot { grid-column: 1 / span 7; grid-row: 1; }
  .area__no { color: var(--c-fg); }
  .area__h { margin-top: 0.5rem; }
  .area__sum { margin-top: 0.75rem; }
  .area__list { margin-top: 1.5rem; display: grid; gap: 0.7rem; font-size: var(--t-s); line-height: 1.5; color: var(--c-soft); }
  .area__list li { position: relative; padding-left: 1rem; }
  .area__list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 0.35rem; height: 0.35rem; background: var(--c-line-strong); }
  .area__shot figcaption { margin-top: 0.8rem; font-size: var(--t-s); }

  .formats { padding-top: clamp(5rem, 11vw, 9rem); }
  .formats h2 { margin-top: 0.5rem; }
  .formats__lead, .settings__lead { margin-top: 0.75rem; max-width: 38rem; }
  .formats__grid { margin-top: 2rem; border-top: 1px solid var(--c-line); }
  .formats__row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); column-gap: var(--gutter); padding-block: 1rem; border-bottom: 1px solid var(--c-line); }
  .formats__row dt { font-weight: 500; }
  .formats__row dt .edge { margin-left: 0.4rem; }
  .formats__row dd { color: var(--c-soft); word-spacing: 0.2em; line-height: 1.8; }

  .settings { padding-top: clamp(5rem, 11vw, 9rem); }
  .settings h2 { margin-top: 0.5rem; }
  .search { position: relative; display: flex; align-items: center; margin-top: 2rem; max-width: 42rem; border-bottom: 1px solid var(--c-line-strong); transition: border-color 0.18s; }
  .search:focus-within { border-color: var(--c-fg); }
  .search__icon { width: 1.25rem; height: 1.25rem; color: var(--c-muted); flex: none; }
  .search input { flex: 1; min-width: 0; background: none; border: 0; padding: 1rem 0.75rem; font-size: var(--t-m); letter-spacing: -0.01em; color: var(--c-fg); }
  .search input::placeholder { color: var(--c-muted); }
  .search input:focus { outline: none; }
  .search:focus-within { box-shadow: 0 1px 0 var(--c-fg); }
  .search input:focus-visible { outline: 2px solid var(--c-fg); outline-offset: 4px; border-radius: 2px; }
  .search__count { flex: none; }
  .search__empty { margin-top: 1.5rem; }
  .settings__list { margin-top: 2.5rem; border-top: 1px solid var(--c-line); }
  .sp { border-bottom: 1px solid var(--c-line); }
  .sp__sum { display: grid; grid-template-columns: minmax(0, 1fr) auto 1.5rem; align-items: center; gap: 1.5rem; min-height: 4rem; cursor: pointer; list-style: none; font-size: var(--t-m); letter-spacing: -0.015em; }
  .sp__sum::-webkit-details-marker { display: none; }
  .sp__chev { width: 0.7rem; height: 0.7rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; rotate: 45deg; translate: 0 -0.2rem; transition: rotate 0.22s cubic-bezier(0.6, 0, 0.25, 1); justify-self: center; }
  .sp[open] .sp__chev { rotate: 225deg; translate: 0 0.15rem; }
  @media (hover: hover) { .sp__sum:hover .sp__name { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; } }
  .ss { padding-bottom: 1.5rem; }
  .ss__h { color: var(--c-fg); padding-block: 0.75rem 0.5rem; }
  .row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); column-gap: var(--gutter); padding-block: 0.7rem; border-top: 1px solid rgb(255 255 255 / 0.04); font-size: var(--t-s); line-height: 1.45; }
  .row__name { color: var(--c-fg); font-weight: 500; }
  .row__kind { color: var(--c-muted); }

  @media (max-width: 900px) {
    .phead__lead { grid-column: 1 / -1; }
    .toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
    .area__text, .area--flip .area__text { grid-column: 1 / -1; grid-row: auto; position: static; }
    .area__shot, .area--flip .area__shot { grid-column: 1 / -1; grid-row: auto; }
    .formats__row { grid-template-columns: 1fr; row-gap: 0.4rem; }
    .row { grid-template-columns: 1fr; row-gap: 0.25rem; }
    .phead__h { font-size: clamp(2.6rem, 13.5vw, 4rem); }
  }
</style>
