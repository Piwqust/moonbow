#include <winres.h>

1 RT_MANIFEST "app.manifest"
1 ICON "lumen.ico"

// Inter (OFL), see res/fonts/Inter-LICENSE.txt. Ids are read by src/gfx/Text.cpp.
201 RCDATA "fonts/Inter-Light.ttf"
202 RCDATA "fonts/Inter-Regular.ttf"
203 RCDATA "fonts/Inter-Medium.ttf"
204 RCDATA "fonts/Inter-SemiBold.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Lumen"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Lumen"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
