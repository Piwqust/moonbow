#include <winres.h>

1 RT_MANIFEST "app.manifest"
1 ICON "moonbow.ico"

// Inter (OFL), see res/fonts/Inter-LICENSE.txt. Ids are read by src/gfx/Text.cpp.
201 RCDATA "fonts/Inter-Light.ttf"
202 RCDATA "fonts/Inter-Regular.ttf"
203 RCDATA "fonts/Inter-Medium.ttf"
204 RCDATA "fonts/Inter-SemiBold.ttf"
// Onest (OFL), see res/fonts/Onest-LICENSE.txt: the text styles. Inter stays for tabular figures.
205 RCDATA "fonts/Onest-Variable.ttf"

// GPU sharpening shader, written to <data>\cache\shaders by src/Player.cpp.
MOONBOW_CAS RCDATA "shaders/moonbow-cas.glsl"

// Built-in skins (design/SKINS.md), read by src/app/Skins.cpp.
MOONBOW_SKIN_OLED RCDATA "skins/oled.json"
MOONBOW_SKIN_CONTRAST RCDATA "skins/contrast.json"
MOONBOW_SKIN_SEPIA RCDATA "skins/sepia.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Moonbow"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Moonbow"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
